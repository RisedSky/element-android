<?xml version="1.0" encoding="utf-8"?>
<!-- Discord-style layout replacing the original Element layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/discord_background">

    <!-- Left Panel - Server List (simplified for Element compatibility) -->
    <LinearLayout
        android:id="@+id/discord_server_panel"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/discord_server_panel_bg"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_horizontal">

        <!-- Home Button -->
        <ImageView
            android:id="@+id/discord_home_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/discord_server_icon_bg"
            android:src="@drawable/ic_home"
            android:scaleType="center"
            android:contentDescription="Home"
            app:tint="@color/discord_icon_color" />

        <!-- Separator -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:background="@color/discord_separator" />

        <!-- Space for servers - keeping original drawer functionality -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Right Panel - Combined channel list and content (maintaining original structure) -->
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/discord_channel_panel_bg"
        tools:openDrawer="start">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinatorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/discord_main_panel_bg">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/homeDetailFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/waiting_view"
                layout="@layout/merge_overlay_waiting_view" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/homeDrawerFragmentContainer"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/discord_channel_panel_bg" />

    </androidx.drawerlayout.widget.DrawerLayout>

</LinearLayout>
