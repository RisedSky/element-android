<?xml version="1.0" encoding="utf-8"?>
<!-- Discord-style layout with three panels: server list, channel list, and main content -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/discord_background">

    <!-- Left Panel - Server List -->
    <LinearLayout
        android:id="@+id/discord_server_panel"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/discord_server_panel_bg"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_horizontal">

        <!-- Home/DM Button -->
        <ImageView
            android:id="@+id/discord_home_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/discord_server_icon_bg"
            android:src="@drawable/ic_home"
            android:scaleType="center"
            android:contentDescription="Home"
            app:tint="@color/discord_icon_color" />

        <!-- Separator -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:background="@color/discord_separator" />

        <!-- Server Icons RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discord_servers_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            tools:listitem="@layout/item_discord_server" />

        <!-- Add Server Button -->
        <ImageView
            android:id="@+id/discord_add_server_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/discord_server_icon_add_bg"
            android:src="@drawable/ic_add"
            android:scaleType="center"
            android:contentDescription="Add Server"
            app:tint="@color/discord_add_icon_color" />

    </LinearLayout>

    <!-- Middle Panel - Channel List -->
    <LinearLayout
        android:id="@+id/discord_channel_panel"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/discord_channel_panel_bg">

        <!-- Server Header -->
        <LinearLayout
            android:id="@+id/discord_server_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/discord_server_header_bg"
            android:elevation="2dp">

            <TextView
                android:id="@+id/discord_server_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Server Name"
                android:textColor="@color/discord_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/discord_server_dropdown"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="@color/discord_text_primary" />

        </LinearLayout>

        <!-- Channels RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discord_channels_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="16dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:listitem="@layout/item_discord_channel" />

        <!-- User Panel -->
        <LinearLayout
            android:id="@+id/discord_user_panel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@color/discord_user_panel_bg">

            <ImageView
                android:id="@+id/discord_user_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/discord_user_avatar_bg"
                android:src="@drawable/ic_person"
                android:scaleType="center"
                app:tint="@color/discord_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/discord_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textColor="@color/discord_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/discord_user_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="@color/discord_text_secondary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <ImageView
                android:id="@+id/discord_settings_button"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                app:tint="@color/discord_text_secondary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Right Panel - Main Content -->
    <LinearLayout
        android:id="@+id/discord_main_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/discord_main_panel_bg">

        <!-- Channel Header -->
        <LinearLayout
            android:id="@+id/discord_channel_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/discord_channel_header_bg"
            android:elevation="1dp">

            <TextView
                android:id="@+id/discord_channel_hash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="@color/discord_text_muted"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/discord_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="general"
                android:textColor="@color/discord_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Channel controls -->
            <ImageView
                android:id="@+id/discord_channel_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_search"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                app:tint="@color/discord_text_secondary" />

            <ImageView
                android:id="@+id/discord_channel_members"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_people"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Members"
                app:tint="@color/discord_text_secondary" />

        </LinearLayout>

        <!-- Main Content Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/discord_main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</LinearLayout>