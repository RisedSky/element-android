<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/discord_main_panel_bg">

    <!-- Members Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/discord_channel_header_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Members"
            android:textColor="@color/discord_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/discord_members_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_24dp"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="@color/discord_text_secondary" />

    </LinearLayout>

    <!-- Members List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/discord_members_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/discord_main_panel_bg"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingTop="8dp" />

</LinearLayout>