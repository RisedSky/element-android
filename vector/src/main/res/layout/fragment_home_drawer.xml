<?xml version="1.0" encoding="utf-8"?>
<!-- Discord-style channel list drawer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/discord_channel_panel_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Discord-style Server Header -->
    <LinearLayout
        android:id="@+id/homeDrawerHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/discord_server_header_bg"
        android:elevation="2dp">

        <TextView
            android:id="@+id/homeDrawerUsernameView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Element"
            android:textColor="@color/discord_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Element Server" />

        <ImageView
            android:id="@+id/homeDrawerQRCodeButton"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/discord_text_primary" />

    </LinearLayout>

    <!-- Channels Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/homeDrawerGroupListContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp" />

    <!-- Discord-style User Panel -->
    <LinearLayout
        android:id="@+id/discord_user_panel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/discord_user_panel_bg">

        <ImageView
            android:id="@+id/homeDrawerHeaderAvatarView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/discord_user_avatar_bg"
            android:scaleType="center"
            tools:src="@sample/user_round_avatars" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeDrawerUsernameViewUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/discord_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="@sample/users.json/data/displayName" />

            <TextView
                android:id="@+id/homeDrawerUserIdView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="@color/discord_text_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Online" />

        </LinearLayout>

        <ImageView
            android:id="@+id/homeDrawerHeaderSettingsView"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_settings"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            app:tint="@color/discord_text_secondary" />

    </LinearLayout>

    <!-- Hidden elements for compatibility -->
    <View
        android:id="@+id/homeDrawerHeaderSeparator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/homeDrawerBottomSeparator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/homeDrawerHeaderSignoutView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/homeDrawerInviteFriendButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/homeDrawerHeaderDebugView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
