<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/discord_channel_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp"
    android:background="?selectableItemBackground"
    android:minHeight="32dp">

    <!-- Channel type icon -->
    <ImageView
        android:id="@+id/discord_channel_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_hashtag"
        app:tint="@color/discord_text_muted"
        tools:src="@drawable/ic_hashtag" />

    <!-- Channel name -->
    <TextView
        android:id="@+id/discord_channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="general"
        android:textColor="@color/discord_text_secondary"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="general" />

    <!-- Unread badge -->
    <TextView
        android:id="@+id/discord_channel_unread"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/discord_unread_badge_bg"
        android:gravity="center"
        android:minWidth="16dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="5"
        android:textColor="@color/discord_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="5" />

</LinearLayout>