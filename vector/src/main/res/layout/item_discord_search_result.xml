<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?selectableItemBackground">

    <ImageView
        android:id="@+id/search_result_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_hashtag"
        app:tint="@color/discord_text_muted"
        tools:src="@drawable/ic_hashtag" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/search_result_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/discord_text_primary"
            android:textSize="16sp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="general" />

        <TextView
            android:id="@+id/search_result_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/discord_text_secondary"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="#general" />

    </LinearLayout>

</LinearLayout>