<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/discord_server_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/discord_server_icon_bg"
        android:scaleType="center"
        android:contentDescription="Server"
        tools:src="@drawable/ic_home" />

    <!-- Unread indicator -->
    <TextView
        android:id="@+id/discord_server_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/discord_unread_badge_bg"
        android:textColor="@color/discord_text_primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:minWidth="16dp"
        android:minHeight="16dp"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        tools:text="5"
        tools:visibility="visible" />

</FrameLayout>